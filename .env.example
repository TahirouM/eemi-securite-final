# Variables d'environnement attendues par l'application.
# Copier ce fichier en `.env` puis renseigner des valeurs DEMO_ONLY.

# Port d'écoute du serveur HTTP
PORT=3000

# Secret de signature des JWT.
# Branche vulnerable : volontairement faible / codé en dur dans le code.
# Branche secure    : doit être long et aléatoire (>= 32 caractères).
JWT_SECRET=change_me_with_a_strong_random_value

# Environnement d'exécution (development | production)
NODE_ENV=development
