# Variables d'environnement attendues par l'application (branche secure).
# Copier ce fichier en `.env` puis renseigner les valeurs. Le `.env` n'est
# JAMAIS committé (correction VULN-06).

# Port d'écoute du serveur HTTP
PORT=3000

# Secret de signature des JWT.
# DOIT être long et aléatoire (>= 32 caractères). Générer par ex. avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacer_par_une_valeur_aleatoire_de_64_caracteres_minimum

# Environnement d'exécution (development | production)
NODE_ENV=development
